{
  "description": "CETA recording hooks (permission requests, denials, failures, session end); left out on a machine whose tracker cut-over switch is on",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-extended-tool-approver",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-extended-tool-approver",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-extended-tool-approver",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-extended-tool-approver",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
