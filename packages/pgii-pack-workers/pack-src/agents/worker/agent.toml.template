# worker — generic pool-worker agent applied per-rig.
#
# Same template runs on every rig that imports the pgii-workers pack.
# The Go template engine fills in {{.Rig}} / {{.RigName}} / {{.RigRoot}}
# in the prompt and work_dir at materialization time, so each rig
# effectively gets its own worker without us having to write a per-rig
# agent.toml.
#
# Concurrency starts at min=0/max=1 across the board. The ziprecruiter
# rig wants 0/3 — that's a per-rig override (see city.toml). Personal
# rigs stay at 0/1.
#
# Behavior: claims open beads that have acceptance_criteria set and
# are not flagged for foreman attention. On ambiguity, labels the
# bead `needs-foreman` and exits.
scope = "rig"
wake_mode = "fresh"
idle_timeout = "1h"
min_active_sessions = 0
max_active_sessions = 1
work_dir = ".gc/worktrees/{{.Rig}}/worker/{{.AgentBase}}"
# pre_start runs two scripts in order before the worker session starts:
#
#   1. worktree-setup.sh provisions a git worktree under {{.WorkDir}}.
#      Without this, the work_dir exists but contains no checkout.
#
#   2. The user's home-manager-managed post-checkout hook runs the same
#      convergence logic that fires on a normal `git checkout`: it
#      checks if the remote is ZR-Private/ziprecruiter and, if so,
#      invokes `zm-ensure-worktree-state` which:
#        - symlinks devbox.json from tools/devbox/devbox.json.template
#        - writes .envrc.local with the worktree-specific monorepo env
#        - runs `direnv allow` so the env is trusted
#        - runs `devbox install` if the devbox config hash changed
#      The hook is a no-op for non-ZR rigs (remote check at top).
#      Path is the home-manager symlink so it survives nix rebuilds
#      (the symlink target rotates, the path is stable).
pre_start = [
  # Removed --sync flag: the trailing `git fetch origin && git pull --rebase`
  # consistently exceeds the supervisor's pre_start timeout (~10s) on this
  # rig and gets killed mid-execution, which (a) marks the session
  # provider_error so it never starts and (b) skips the post-checkout zm
  # hook entirely. Workers now run `git mu` (fetch+rebase --autostash
  # --autosquash origin/main) themselves on entry, so pre_start sync is
  # redundant. See prompt.template.md step 3.
  "/Users/phillipg/gc/.gc/system/packs/gastown/assets/scripts/worktree-setup.sh {{.RigRoot}} {{.WorkDir}} {{.AgentBase}}",
  "cd {{.WorkDir}} && bash $HOME/.config/git/hooks/post-checkout.d/zm",
]
# Claude's bash tool calls each spawn a fresh `bash -c` subprocess, which
# does NOT source ~/.bashrc and therefore does NOT trigger direnv's hook.
# Without direnv activated, devbox-provided tools (most importantly `step`,
# required by ZR-Private SSH cert auth) are missing from PATH and any git
# push/fetch fails with "command not found: step". BASH_ENV makes every
# non-interactive bash source the script below, which evaluates direnv
# export for the cwd. The script is idempotent (guards via env sentinel)
# and a no-op if direnv or .envrc is absent.
# BEADS_ACTOR uses the rig name as a suffix so the audit trail
# distinguishes which rig's worker pool did the write
# (workers spawn one per rig). Pin so bd writes never fall through
# to git user.name → "Phillip Green II".
env = { BASH_ENV = "${PACK_ROOT}/agents/worker/scripts/bash-env.sh", BEADS_ACTOR = "pgii-workers__worker__{{.Rig}}" }
nudge = "Run gc hook for routed work, then bd ready to find a ready bead with acceptance_criteria."

# Pick up open beads in the current rig's bd store that have AC populated
# and aren't flagged for foreman attention or escalation.
work_query = "bd list --status=open --json --limit 0 | jq -r 'if type == \"array\" then .[] | select(.status == \"open\" and (.acceptance_criteria != null and .acceptance_criteria != \"\") and ((.labels // []) | any(. == \"needs-foreman\") | not) and ((.labels // []) | any(. == \"gc:escalation\") | not)) | .id else empty end'"
