# HACK: until the gascity supervisor reconciler materializes on_demand named
# sessions when their work_query returns hits, this order pokes the supervisor
# every few minutes. Retire when the supervisor bug is fixed upstream. Mirrors
# orders/hack-wake-on-work.toml in the legacy pack.
[order]
description = "HACK: nudge supervisor to materialize on_demand sessions when work_query has hits."
trigger     = "cooldown"
interval    = "5m"
exec        = "${SCRIPTS_DIR}/wake-on-work.sh"
timeout     = "60s"
enabled     = true
