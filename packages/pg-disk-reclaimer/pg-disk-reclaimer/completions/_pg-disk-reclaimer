#compdef pg-disk-reclaimer

# _pg_disk_reclaimer_item_ids: best-effort -- offers registered item ids
# read from the same XDG registry path pg-disk-reclaimer.bash's
# pgdr_default_registry_path resolves. A missing/unreadable/malformed
# registry silently yields no ids rather than erroring the completion.
_pg_disk_reclaimer_item_ids() {
  local registry="${XDG_CONFIG_HOME:-$HOME/.config}/pg-disk-reclaimer/registry.json"
  [[ -r $registry ]] || return 0
  local -a ids
  ids=(${(f)"$(jq -r '.[].id' "$registry" 2>/dev/null)"})
  _describe 'item id' ids
}

_pg_disk_reclaimer() {
  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help message]' \
    '(-v --version)'{-v,--version}'[Show version information]' \
    '1: :(list validate reclaim)' \
    '*::args:->args'

  case $words[1] in
  reclaim)
    _arguments \
      '--aggressiveness[Selection ceiling]:aggressiveness:' \
      '--apply[Actually reclaim instead of dry-run]' \
      '(-v --verbose)'{-v,--verbose}'[Show a note when a selected item path does not exist]' \
      '*:item id:_pg_disk_reclaimer_item_ids'
    ;;
  list)
    _arguments \
      '--aggressiveness[Selection ceiling]:aggressiveness:' \
      '(-v --verbose)'{-v,--verbose}'[Also show items whose path does not exist]'
    ;;
  *)
    _files
    ;;
  esac
}

_pg_disk_reclaimer "$@"
