      "description": "Count of stored check verdicts by result.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_repo_runner_check_verdicts{repo=\"$repo\"}",
          "legendFormat": "{{result}}",
          "editorMode": "code",
          "range": true
        }
