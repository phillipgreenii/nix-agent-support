{
  "uid": "pg-repo-runner",
  "title": "pg-repo-runner",
  "schemaVersion": 39,
  "tags": ["pg-repo-runner"],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_repo_runner_tips_ok, repo)",
          "refId": "repo"
        },
        "definition": "label_values(pg_repo_runner_tips_ok, repo)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Repo",
      "repeat": "repo",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tips ok",
      "description": "1 when the repo was read, 0 when the run failed (alert: tips failing).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_repo_runner_tips_ok{repo=\"$repo\"}",
          "legendFormat": "tips_ok",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latest verdict red",
      "description": "1 when the latest non-superseded check verdict is red (alert: red with no newer tip).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_repo_runner_check_latest_red{repo=\"$repo\"}",
          "legendFormat": "latest red",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
