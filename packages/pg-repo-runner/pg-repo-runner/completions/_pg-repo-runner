#compdef pg-repo-runner

_arguments \
  '(-h --help)'{-h,--help}'[Show help message]' \
  '(-v --version)'{-v,--version}'[Show version information]' \
  '1:command:(tips workspace-tips verify sync build status)' \
  '*::status option:->opts'

case $state in
opts)
  if [[ ${words[1]} == status ]]; then
    _arguments \
      '--json[Print only the verdicts, as one JSON array]' \
      '--repo[Only this repo'"'"'s verdicts]:repo key:'
  elif [[ ${words[1]} == tips ]]; then
    _arguments \
      '--repo[Only this repo'"'"'s tip]:repo key:'
  fi
  ;;
esac
