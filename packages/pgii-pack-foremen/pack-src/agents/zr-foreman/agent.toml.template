# zr-foreman — enhances newly-arrived work beads in the ziprecruiter
# rig's db. Same shape as city-foreman; different scope.
#
# Reference: docs/superpowers/specs/2026-05-28-triage-extension-design.md

scope = "city"
wake_mode = "fresh"
idle_timeout = "1h"
min_active_sessions = 0
max_active_sessions = 1
model = "claude-opus-4-7"
nudge = "Wake check: zr work beads needing enhancement or AC-fill."
# Pin BEADS_ACTOR so bd writes from this session never fall through
# to git user.name (which would attribute to "Phillip Green II").
env = { BEADS_ACTOR = "pgii-foremen__zr-foreman" }

work_query = "${PACK_ROOT}/agents/zr-foreman/work_query.sh"
