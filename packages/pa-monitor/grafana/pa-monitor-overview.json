{
  "title": "pa-monitor overview",
  "uid": "pa-monitor-overview",
  "tags": ["pa-monitor", "claude-agents"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "scope",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pa_monitor_sessions_count, workspace_scope)",
        "includeAll": true,
        "multi": true,
        "current": {
          "value": "$__all",
          "text": "All"
        }
      },
      {
        "name": "plan_tier",
        "label": "plan_tier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pa_monitor_sessions_count, plan_tier)",
        "includeAll": true,
        "multi": true,
        "current": {
          "value": "$__all",
          "text": "All"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Current status",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 101,
      "title": "Sessions (current)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "sessions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "title": "Sessions errored (current)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_errored)",
          "legendFormat": "errored",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 103,
      "title": "Caffeinated",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(pa_monitor_caffeinate_active)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "text"
                },
                "1": {
                  "text": "Enabled",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5a5a5a"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 104,
      "title": "Auto Nudge",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(pa_monitor_auto_resume_enabled)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "text"
                },
                "1": {
                  "text": "Enabled",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5a5a5a"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 1,
      "title": "Sessions by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (state) (pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 19,
      "title": "Session state mix (now)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (state) (pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Active sessions",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "description": "One row per active (non-Dormant) session — mirrors the TUI 'active' view. Joined on session_id from pa_monitor_session_info (labels), pa_monitor_session_tokens, and pa_monitor_session_cost_usd.",
      "targets": [
        {
          "expr": "pa_monitor_session_info{plan_tier=~\"$plan_tier\", workspace_scope=~\"$scope\"}",
          "format": "table",
          "instant": true,
          "refId": "A",
          "legendFormat": "__auto"
        },
        {
          "expr": "pa_monitor_session_tokens",
          "format": "table",
          "instant": true,
          "refId": "B",
          "legendFormat": "__auto"
        },
        {
          "expr": "pa_monitor_session_cost_usd",
          "format": "table",
          "instant": true,
          "refId": "C",
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "service_name 1": true,
              "service_name 2": true,
              "service_name 3": true,
              "service_version 1": true,
              "service_version 2": true,
              "service_version 3": true,
              "telemetry_sdk_language 1": true,
              "telemetry_sdk_language 2": true,
              "telemetry_sdk_language 3": true,
              "telemetry_sdk_name 1": true,
              "telemetry_sdk_name 2": true,
              "telemetry_sdk_name 3": true,
              "telemetry_sdk_version 1": true,
              "telemetry_sdk_version 2": true,
              "telemetry_sdk_version 3": true,
              "otel_scope_name 1": true,
              "otel_scope_name 2": true,
              "otel_scope_name 3": true,
              "otel_scope_version 1": true,
              "otel_scope_version 2": true,
              "otel_scope_version 3": true,
              "Value #A": true
            },
            "indexByName": {
              "cwd": 0,
              "terminal_host": 1,
              "session_id": 2,
              "session_name": 3,
              "status": 4,
              "model": 5,
              "Value #B": 6,
              "Value #C": 7,
              "error_kind": 8
            },
            "renameByName": {
              "cwd": "path",
              "terminal_host": "terminal",
              "session_id": "id",
              "session_name": "name",
              "Value #B": "tokens",
              "Value #C": "cost",
              "error_kind": "current error"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "working": {
                        "color": "green",
                        "index": 0
                      },
                      "idle": {
                        "color": "yellow",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "current error"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "": {
                        "color": "text",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "title": "5h block usage vs cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "description": "Cap-hit events appear in the 'Block limit hits (1d)' stat below and as a discrete event in 'API errors observed' when the daemon escalates a rate_limit kind. The timeseries itself plots cost_usd, which plateaus when the cap is reached.",
      "targets": [
        {
          "expr": "sum by (block_id, plan_tier) (pa_monitor_block_cost_usd{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{block_id}} ({{plan_tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "title": "Weekly usage vs cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "description": "Cap-hit events appear in the 'Week limit hits (7d)' stat below. The timeseries plots cost_usd, which plateaus when the weekly cap is reached.",
      "targets": [
        {
          "expr": "sum by (week_id, plan_tier) (pa_monitor_week_cost_usd{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{week_id}} ({{plan_tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "Block limit hits (1d)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_block_usage_limit_hits_total[1d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Week limit hits (7d)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_week_usage_limit_hits_total[7d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API Errors & Nudges",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "API errors observed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(pa_monitor_session_api_error_observed_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Sessions currently errored (terminal)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (kind) (pa_monitor_sessions_errored)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nudges sent by error_kind",
      "type": "timeseries",
      "description": "Excludes empty error_kind (manual / non-error-triggered nudges) so the panel only renders error-driven activity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (error_kind) (rate(pa_monitor_signal_sends_total{error_kind!=\"\"}[5m]))",
          "legendFormat": "{{error_kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Nudges sent by source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (sources) (rate(pa_monitor_signal_sends_total[5m]))",
          "legendFormat": "{{sources}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Stuck on retryable error",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_errored{kind=~\"unknown|server_error\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Nudges suppressed (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 49,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_nudge_suppressed_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Caffeinate grace expirations (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 49,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_caffeinate_grace_expirations_total[1h]))",
          "legendFormat": "expirations",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Nudge funnel (5m rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(pa_monitor_nudge_queued_total[5m]))",
          "legendFormat": "queued",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pa_monitor_signal_sends_total[5m]))",
          "legendFormat": "sent",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pa_monitor_nudge_suppressed_total[5m]))",
          "legendFormat": "suppressed",
          "refId": "C"
        },
        {
          "expr": "sum(rate(pa_monitor_signal_send_failures_total[5m]))",
          "legendFormat": "send failed",
          "refId": "D"
        }
      ]
    },
    {
      "id": 106,
      "title": "Nudge send failures (1h)",
      "type": "stat",
      "description": "Signaler.Send errors (e.g. cmux delivery failed) — a non-zero value means an auto-resume nudge was generated but never delivered.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 53,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_signal_send_failures_total[1h]))",
          "legendFormat": "send failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "Sessions breakdown",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 18,
      "title": "Sessions by agent.kind",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (agent_kind) (pa_monitor_sessions_count{agent_kind!=\"\", workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{agent_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 20,
      "title": "Sessions by workspace.scope",
      "type": "timeseries",
      "description": "Every session emits a workspace.scope label — Gas City sessions surface as 'gascity', others as 'personal' (set by the DefaultScope detector).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (workspace_scope) (pa_monitor_sessions_count{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{workspace_scope}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 30,
      "title": "Caffeinate & context limits",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 22,
      "title": "Caffeinate rounds (by cause)",
      "type": "timeseries",
      "description": "Caffeinate activations (pa_monitor_caffeinate_rounds_total) split by cause — a round is one off→on transition of the caffeinate manager (manual toggle vs agents_active).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (cause) (increase(pa_monitor_caffeinate_rounds_total[5m]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Context-limit hits (by model, 1h)",
      "type": "timeseries",
      "description": "Sessions that hit the model context window — Claude Code 'prompt is too long' (invalid_request) errors, counted via pa_monitor_session_context_limit_hits_total and split by model.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 68,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(pa_monitor_session_context_limit_hits_total[1h]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 31,
      "title": "Event log",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 75,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 25,
      "title": "pa-monitor events (OTel log stream)",
      "type": "logs",
      "description": "Structured OTel log events emitted by the daemon (block/week limit hits, caffeinate start/grace, nudge queued/sent/suppressed, api_error.observed, session.context.limit_hit). Requires a Loki datasource (uid 'loki') provisioned by the consuming observability flake; the OTLP log pipeline must land records under service_name=\"pa-monitor\". Adjust the selector if your Loki label set differs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=\"pa-monitor\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Authentication",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_errored{kind=\"authentication_failed\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ Auth OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000,
                "result": {
                  "text": "⊘ AUTHENTICATION FAILURE — run /login",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 107,
      "type": "stat",
      "title": "Daemon connection",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "targets": [
        {
          "expr": "min by (component) (pa_monitor_daemon_connected)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "⊘ DISCONNECTED",
                  "color": "red"
                },
                "1": {
                  "text": "✓ Connected",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    }
  ]
}
