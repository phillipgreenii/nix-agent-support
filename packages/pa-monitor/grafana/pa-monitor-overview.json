        {
          "expr": "sum(increase(pa_monitor_signal_sends_total[$__range]))",
          "legendFormat": "sent",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum(increase(pa_monitor_nudge_suppressed_total[$__range]))",
