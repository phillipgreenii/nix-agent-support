{
  "title": "pa-monitor overview",
  "uid": "pa-monitor-overview",
  "tags": ["pa-monitor", "claude-agents"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "scope",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(pa_monitor_sessions_count, workspace_scope)",
        "includeAll": true,
        "multi": true,
        "current": { "value": "$__all", "text": "All" }
      },
      {
        "name": "plan_tier",
        "label": "plan_tier",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(pa_monitor_sessions_count, plan_tier)",
        "includeAll": true,
        "multi": true,
        "current": { "value": "$__all", "text": "All" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Sessions by state",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (state) (pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" } } }
      }
    },
    {
      "id": 2,
      "title": "5h block usage vs cap",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "pa_monitor_block_cost_usd{plan_tier=~\"$plan_tier\"}",
          "legendFormat": "block.id={{block_id}} ({{plan_tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 3,
      "title": "Weekly usage vs cap",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "pa_monitor_week_cost_usd{plan_tier=~\"$plan_tier\"}",
          "legendFormat": "week.id={{week_id}} ({{plan_tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 4,
      "title": "Block limit hits (1d)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 7, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_block_usage_limit_hits_total[1d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Week limit hits (7d)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 7, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_week_usage_limit_hits_total[7d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Caffeinate active",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "pa_monitor_caffeinate_active",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pa_monitor_caffeinate_rounds_total[5m]))",
          "legendFormat": "rounds/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nudges sent (split by post_window)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (post_window) (increase(pa_monitor_signal_sends_total[5m]))",
          "legendFormat": "post_window={{post_window}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API Errors & Nudges",
      "type": "row",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "API errors observed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(pa_monitor_session_api_error_observed_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" } } }
      }
    },
    {
      "id": 10,
      "title": "Sessions currently errored (terminal)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (kind) (pa_monitor_sessions_errored)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Stuck on retryable error",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 28, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_errored{kind=~\"unknown|server_error\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Nudges suppressed (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 28, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_nudge_suppressed_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Nudges sent by source",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (sources) (rate(pa_monitor_signal_sends_total[5m]))",
          "legendFormat": "{{sources}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" } } }
      }
    }
  ]
}
