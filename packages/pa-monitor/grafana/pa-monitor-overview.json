{
  "title": "pa-monitor overview",
  "uid": "pa-monitor-overview",
  "tags": ["pa-monitor", "claude-agents"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scope",
        "label": "scope",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pa_monitor_sessions_count, workspace_scope)",
        "refresh": 2,
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "current": {
          "value": "$__all",
          "text": "All"
        }
      },
      {
        "name": "plan_tier",
        "label": "plan_tier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pa_monitor_sessions_count, plan_tier)",
        "refresh": 2,
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "current": {
          "value": "$__all",
          "text": "All"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Current status",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 101,
      "title": "Sessions (current)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "sessions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "title": "Sessions errored (current)",
      "type": "stat",
      "description": "Not filtered by $scope/$plan_tier. Reads 0 only while the daemon is exporting (liveness-gated zero); see Authentication and Daemon connection for liveness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(pa_monitor_sessions_errored)) or (vector(0) and on() (max(pa_monitor_sessions_count) >= 0))",
          "legendFormat": "errored",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 103,
      "title": "Caffeinated",
      "type": "stat",
      "description": "Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(pa_monitor_caffeinate_active)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "text"
                },
                "1": {
                  "text": "Enabled",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5a5a5a"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 104,
      "title": "Auto Nudge",
      "type": "stat",
      "description": "Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(pa_monitor_auto_resume_enabled)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "text"
                },
                "1": {
                  "text": "Enabled",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#5a5a5a"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 1,
      "title": "Sessions by state",
      "type": "timeseries",
      "description": "Sessions grouped by status over the selected range (working | blocked | idle). Trusts the carry-forward-zero gauge, so a stale series reads 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (state) (pa_monitor_sessions_count{workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 32,
      "title": "Blocked by reason",
      "type": "timeseries",
      "description": "Decomposition of the `blocked` state by `blocker` (human_input | human_authn | usage_limit | error). Only sessions with state=blocked carry a blocker label.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (blocker) (pa_monitor_sessions_count{state=\"blocked\", workspace_scope=~\"$scope\", plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{blocker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 21,
      "title": "Active sessions",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "description": "One row per active (non-Dormant) session — mirrors the TUI 'active' view. Joined on session_id from pa_monitor_session_info (labels), pa_monitor_session_tokens, and pa_monitor_session_cost_usd. The info query is wrapped in topk(1, timestamp(...)) by (session_id) so that when a mutable label (e.g. status idle->working) spawns a second series, only the freshest one renders — otherwise both stay live within Prometheus staleness and the join shows the session as two rows mid-transition.",
      "targets": [
        {
          "expr": "topk(1, timestamp(pa_monitor_session_info{plan_tier=~\"$plan_tier\", workspace_scope=~\"$scope\"})) by (session_id)",
          "format": "table",
          "instant": true,
          "refId": "A",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (session_id) (pa_monitor_session_tokens)",
          "format": "table",
          "instant": true,
          "refId": "B",
          "legendFormat": "__auto"
        },
        {
          "expr": "max by (session_id) (pa_monitor_session_cost_usd)",
          "format": "table",
          "instant": true,
          "refId": "C",
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "service_name 1": true,
              "service_name 2": true,
              "service_name 3": true,
              "service_version 1": true,
              "service_version 2": true,
              "service_version 3": true,
              "telemetry_sdk_language 1": true,
              "telemetry_sdk_language 2": true,
              "telemetry_sdk_language 3": true,
              "telemetry_sdk_name 1": true,
              "telemetry_sdk_name 2": true,
              "telemetry_sdk_name 3": true,
              "telemetry_sdk_version 1": true,
              "telemetry_sdk_version 2": true,
              "telemetry_sdk_version 3": true,
              "otel_scope_name 1": true,
              "otel_scope_name 2": true,
              "otel_scope_name 3": true,
              "otel_scope_version 1": true,
              "otel_scope_version 2": true,
              "otel_scope_version 3": true,
              "Value #A": true,
              "host_name 2": true,
              "host_name 3": true,
              "os_type 2": true,
              "os_type 3": true
            },
            "indexByName": {
              "cwd": 0,
              "terminal_host": 1,
              "session_id": 2,
              "session_name": 3,
              "status": 4,
              "model": 5,
              "Value #B": 6,
              "Value #C": 7,
              "error_kind": 8,
              "host_name 1": 9,
              "os_type 1": 10
            },
            "renameByName": {
              "cwd": "path",
              "terminal_host": "terminal",
              "session_id": "id",
              "session_name": "name",
              "Value #B": "tokens",
              "Value #C": "cost",
              "error_kind": "current error",
              "host_name 1": "host",
              "os_type 1": "os"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "working": {
                        "color": "green",
                        "index": 0
                      },
                      "blocked": {
                        "color": "orange",
                        "index": 1
                      },
                      "idle": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "current error"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "": {
                        "color": "text",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "title": "5h block cost and usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "description": "Cost (left axis, USD) and usage percentage (right axis, percent of cap) of the current 5h block, one series per plan_tier. Cap-hit events appear in the 'Block limit hits (range)' stat below and as a discrete event in 'API errors observed' when the daemon escalates a rate_limit kind. Not filtered by $scope.",
      "targets": [
        {
          "expr": "max by (plan_tier) (pa_monitor_block_cost_usd{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{plan_tier}} cost",
          "refId": "A"
        },
        {
          "expr": "max by (plan_tier) (pa_monitor_block_usage_percentage{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{plan_tier}} usage",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Weekly cost and usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "description": "Cost (left axis, USD) and usage percentage (right axis, percent of cap) of the current week, one series per plan_tier. Cap-hit events appear in the 'Week limit hits (range)' stat below. Not filtered by $scope.",
      "targets": [
        {
          "expr": "max by (plan_tier) (pa_monitor_week_cost_usd{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{plan_tier}} cost",
          "refId": "A"
        },
        {
          "expr": "max by (plan_tier) (pa_monitor_week_usage_percentage{plan_tier=~\"$plan_tier\"})",
          "legendFormat": "{{plan_tier}} usage",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "Block limit hits (range)",
      "type": "stat",
      "description": "Block cap hits over the selected time range. Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_block_usage_limit_hits_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Week limit hits (range)",
      "type": "stat",
      "description": "Weekly cap hits over the selected time range. Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(pa_monitor_week_usage_limit_hits_total[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API Errors & Nudges",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "API errors observed",
      "type": "timeseries",
      "description": "API errors observed per interval, by kind. Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(pa_monitor_session_api_error_observed_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Sessions currently errored (terminal)",
      "type": "timeseries",
      "description": "Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (kind) (pa_monitor_sessions_errored{is_terminal=\"true\"})",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Nudges sent by error_kind",
      "type": "timeseries",
      "description": "Excludes empty error_kind (manual / non-error-triggered nudges) so the panel only renders error-driven activity. Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (error_kind) (rate(pa_monitor_signal_sends_total{error_kind!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{error_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no nudges (auto-resume disabled)"
        }
      }
    },
    {
      "id": 13,
      "title": "Nudges sent by source",
      "type": "timeseries",
      "description": "Not filtered by $scope/$plan_tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (sources) (rate(pa_monitor_signal_sends_total[$__rate_interval]))",
          "legendFormat": "{{sources}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no nudges (auto-resume disabled)",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Stuck (blocked: usage_limit/error)",
      "type": "stat",
      "description": "Sessions blocked on a machine-recoverable condition (blocker usage_limit or error). Pair with 'Auto-resume deferred' to tell 'broken' apart from 'deliberately waiting on a window reset'. Replaces the old kind=~unknown|server_error filter, which never matched rate_limit. Not filtered by $scope/$plan_tier. Reads 0 only while the daemon is exporting (liveness-gated zero).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(pa_monitor_sessions_count{state=\"blocked\", blocker=~\"usage_limit|error\"})) or (vector(0) and on() (max(pa_monitor_sessions_count) >= 0))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Nudges suppressed (range)",
      "type": "stat",
      "description": "Nudges suppressed over the selected time range. Not filtered by $scope/$plan_tier. Reads 0 only while the daemon is exporting (liveness-gated zero).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 49,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(pa_monitor_nudge_suppressed_total[$__range]))) or (vector(0) and on() (max(pa_monitor_sessions_count) >= 0))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Caffeinate grace expirations (range)",
      "type": "stat",
      "description": "Caffeinate grace expirations over the selected time range. Not filtered by $scope/$plan_tier. Reads 0 only while the daemon is exporting (liveness-gated zero).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(pa_monitor_caffeinate_grace_expirations_total[$__range]))) or (vector(0) and on() (max(pa_monitor_sessions_count) >= 0))",
          "instant": true,
          "legendFormat": "expirations",
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
      "title": "Auto-resume deferred (waiting on window)",
      "type": "stat",
      "description": "Sessions where auto-resume is deliberately WAITING for a rate-limit window reset (pa_monitor_nudge_deferred, cause=window_pending). Distinguishes 'deliberately waiting' from 'broken' — a non-zero value explains why blocked/usage_limit sessions are not being nudged yet. Not filtered by $scope/$plan_tier. Reads 0 only while the daemon is exporting (liveness-gated zero).",
