# HELP beads_created_last_24h Beads created in the last 24 hours, counted by the throughput pass.
# TYPE beads_created_last_24h gauge
beads_created_last_24h{db="alpha"} 1
# HELP beads_closed_last_24h Beads closed in the last 24 hours, counted by the throughput pass.
# TYPE beads_closed_last_24h gauge
beads_closed_last_24h{db="alpha"} 0
# HELP beads_exporter_up 1 if the last main collection cycle for this database succeeded, 0 if it failed.
# TYPE beads_exporter_up gauge
beads_exporter_up{db="alpha"} 0
beads_exporter_up{db="beta"} 0
# HELP beads_exporter_pass_last_success_timestamp_seconds Time of the last successful run of each collection pass (main, throughput or stranded), in Unix seconds. Omitted until the pass has succeeded once.
# TYPE beads_exporter_pass_last_success_timestamp_seconds gauge
beads_exporter_pass_last_success_timestamp_seconds{db="alpha",pass="main"} 1780315200.6
beads_exporter_pass_last_success_timestamp_seconds{db="alpha",pass="throughput"} 1780315261.6
