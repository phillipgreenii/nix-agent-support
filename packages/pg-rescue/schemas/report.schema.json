{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phillipgreenii/pg-rescue/schemas/report.schema.json",
  "title": "pg-rescue failure report (report.json), schema_version 1",
  "description": "The report the wrapper writes before each handler runs. Top-level attempt fields are facts recorded by the wrapper; attempt.reported holds the handler's own claims. A breaking change MUST increment schema_version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "parent_run_id",
    "depth",
    "chain",
    "handlers",
    "mode",
    "command",
    "fingerprint",
    "output_file",
    "output_tail",
    "context",
    "verify",
    "host",
    "started_at",
    "attempts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "parent_run_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "depth": { "type": "integer", "minimum": 1 },
    "chain": {
      "description": "The chain name; null when the run used --handlers.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "handlers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "mode": { "enum": ["argv", "stdin"] },
    "command": {
      "description": "null in stdin mode.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/command" }]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_file": { "type": "string", "minLength": 1 },
    "output_tail": {
      "description": "Last 200 lines, at most 64 KiB, redacted.",
      "type": "string"
    },
    "context": { "type": "string" },
    "verify": {
      "description": "The --verify command; null when the original argv is re-run.",
      "type": ["string", "null"]
    },
    "host": { "type": "string" },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "attempts": {
      "description": "One entry per handler tried so far.",
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "argv" } } },
      "then": { "properties": { "command": { "type": "object" } } },
      "else": { "properties": { "command": { "type": "null" } } }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "exit"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "exit": {
          "description": "The command's exit code; 128+signo if a signal killed it.",
          "type": "integer"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handler",
        "position",
        "tags",
        "outcome",
        "reason",
        "exit",
        "duration_ms",
        "stderr_file",
        "reported"
      ],
      "properties": {
        "handler": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "outcome": { "enum": ["resolved", "deferred", "declined", "failed"] },
        "reason": { "type": "string", "minLength": 1 },
        "exit": {
          "description": "The handler's exit code; -1 when it never exited normally (timeout, signal, failure to spawn).",
          "type": "integer"
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "verify_ms": { "type": "integer", "minimum": 0 },
        "stderr_file": { "type": "string", "minLength": 1 },
        "verify_output_file": { "type": "string", "minLength": 1 },
        "reported": { "$ref": "#/$defs/reported" }
      }
    },
    "reported": {
      "description": "The handler's own claims, not facts.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "details": {
          "description": "Capped at 16 KiB; the full text is in details_file.",
          "type": "string"
        },
        "details_file": { "type": "string", "minLength": 1 },
        "meta": { "type": "object" }
      }
    }
  }
}
