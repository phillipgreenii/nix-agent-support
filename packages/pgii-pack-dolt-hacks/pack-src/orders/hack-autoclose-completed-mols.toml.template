# hack-autoclose-completed-mols — workaround for gascity 1.1.0's
# `gc bd close` bypassing the bd on_close hook. The hook
# (.beads/hooks/on_close) would otherwise call `gc convoy autoclose`
# and close a parent molecule once all its step children have closed.
# Because every builtin `mol-*` formula's "Close work and exit" report
# step uses `gc bd close <work-bead>` rather than `bd close`, parent
# molecules accumulate forever and eventually wedge their own orders
# via single-flight gates.
#
# See assets/imports/pgii-dolt-hacks/scripts/hack-autoclose-completed-mols.sh
# for the full backstory and retirement criteria. This order should
# be retired when either:
#   (a) `gc bd close` is fixed upstream to passthrough the on_close
#       hook like `bd close` does, OR
#   (b) the builtin formulas are updated to close their parent
#       molecule explicitly in their report step.
[order]
description = "HACK: close zombie order-run:* molecules whose entire step graph is closed (gc bd close in formula reports bypasses bd's on_close auto-close hook)."
trigger     = "cooldown"
interval    = "10m"
exec        = "${SCRIPTS_DIR}/hack-autoclose-completed-mols.sh"
timeout     = "60s"
enabled     = true
