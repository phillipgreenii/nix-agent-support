      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(pg_task_focus_append_duration_seconds_bucket[1h]))) and on() (sum(rate(pg_task_focus_append_duration_seconds_count[1h])) > 0)",
          "editorMode": "code",
          "range": true,
          "legendFormat": "append"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(pg_task_focus_fsync_duration_seconds_bucket[1h]))) and on() (sum(rate(pg_task_focus_fsync_duration_seconds_count[1h])) > 0)",
          "editorMode": "code",
          "range": true,
          "legendFormat": "fsync"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no appends"
        },
        "overrides": []
      }
    },
