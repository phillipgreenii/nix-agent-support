        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(pg_task_focus_rejections_total[1h]))",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "none yet (or daemon down)"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
