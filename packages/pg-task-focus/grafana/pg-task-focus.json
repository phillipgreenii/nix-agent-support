      "fieldConfig": {
        "defaults": {
          "noValue": "none yet (or daemon down)"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Append and fsync latency p95",
      "description": "p95 over a rolling hour; empty when nothing was appended in that hour. window: fixed - rolling hour, sparse events",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 7
