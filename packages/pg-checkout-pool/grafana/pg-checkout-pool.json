{
  "uid": "pg-checkout-pool",
  "title": "Checkout pool",
  "description": "Slots, leases, resets and waiters of pg-checkout-pool. The alert rules in grafana/alerting/alerts.yaml link to the panels that show the number they read.",
  "tags": ["pg-checkout-pool"],
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Slots by state",
      "description": "Slots in each lifecycle state. A quarantined slot keeps its directory and waits for the operator.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (state) (pg_checkout_pool_slots)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Leaked slots",
      "description": "Leased or resetting slots whose lock is free and whose expiry has passed: held by nobody. Reaped by the janitor (pg-checkout-pool reap).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(pg_checkout_pool_leaked_slots)",
          "legendFormat": "leaked"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Quarantined slots",
      "description": "Slots taken out of rotation after failed resets, a kept release or a failed rescue capture. Nothing removes them automatically.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(pg_checkout_pool_quarantined_slots)",
          "legendFormat": "quarantined"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lease commands waiting for a slot",
      "description": "Lease commands sleeping because every slot is busy and the pool is at its cap or its disk floor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(pg_checkout_pool_waiters)",
          "legendFormat": "waiters"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(pg_checkout_pool_slots{state=\"warm-free\"})",
          "legendFormat": "warm-free slots"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reset duration p50 and p95",
      "description": "Time a slot reset took, over 30 minutes. The reset-slow alert fires when p95 stays above 30 s (the measured ZR reset is about 9 s, at most 14 s under load).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pg_checkout_pool_reset_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pg_checkout_pool_reset_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Acquire wait p95",
      "description": "Time a lease command spent obtaining a slot, over 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pg_checkout_pool_acquire_wait_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Oldest lease age",
      "description": "Age of the oldest active lease.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(pg_checkout_pool_lease_age_seconds)",
          "legendFormat": "oldest lease"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "fsmonitor daemons against slots",
      "description": "One git fsmonitor daemon per slot is expected; the orphan alert fires above slots plus one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(pg_checkout_pool_fsmonitor_daemons)",
          "legendFormat": "daemons"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(pg_checkout_pool_slots{state!=\"retired\"})",
          "legendFormat": "slots"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Free bytes",
      "description": "Free space on the volume that holds the pool. The pool will not grow below its floor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "min(pg_checkout_pool_free_bytes)",
          "legendFormat": "free"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reset failures and rescues",
      "description": "Resets that quarantined a slot, and releases that captured uncommitted work to a rescue ref, per hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pg_checkout_pool_reset_failures_total[1h]))",
          "legendFormat": "reset failures"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(pg_checkout_pool_rescued_total[1h]))",
          "legendFormat": "rescued"
        }
      ]
    }
  ]
}
