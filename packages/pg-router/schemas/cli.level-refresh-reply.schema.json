{
  "$id": "cli.level-refresh-reply",
  "title": "INTF-CLI socket level-refresh verb reply: one result per resource. `level` is present when applied, `reason` when failed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "results"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "outcome"],
        "properties": {
          "resource": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": ["applied", "failed", "no_source"]
          },
          "level": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
