{
  "$id": "cli.level-list-reply",
  "title": "INTF-CLI socket level-list verb reply: one entry per resource. `level` is absent when the resource has no level in force (it prints as \"no reading\"). `source` is sensor, operator (an override) or grace_fallback (a stale sensor value held through its grace). `since` is when the resource entered its current level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "levels"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource"],
        "properties": {
          "resource": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["sensor", "operator", "grace_fallback"]
          },
          "owner": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "age_s": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "boolean"
          },
          "since": {
            "type": "string"
          },
          "reading": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit"],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "override": {
            "type": "object",
            "additionalProperties": false,
            "required": ["until_cleared"],
            "properties": {
              "until_cleared": {
                "type": "boolean"
              },
              "expires_at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
