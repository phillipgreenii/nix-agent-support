{
  "$id": "cli.status-reply",
  "title": "INTF-CLI status --json reply",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveries", "queues", "config"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handler", "event"],
        "properties": {
          "id": { "type": "string" },
          "handler": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "depth"],
        "properties": {
          "type": { "type": "string" },
          "depth": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "handlers"],
      "properties": {
        "sources": { "type": "integer", "minimum": 0 },
        "handlers": { "type": "integer", "minimum": 0 }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string" },
        "version": { "type": "string" },
        "pid": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string" },
        "configPath": { "type": "string" }
      }
    },
    "mode": { "type": "string" },
    "resolvedConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoRoot": { "type": "string" },
        "beadsPrefix": { "type": "string" },
        "pollIntervalMs": { "type": "integer", "minimum": 0 },
        "activeRoles": { "type": "integer", "minimum": 0 },
        "activeQueries": { "type": "integer", "minimum": 0 },
        "perParticipant": { "type": "object" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unconsumedExpired", "unknownTypeRejected", "deduped"],
      "properties": {
        "unconsumedExpired": { "type": "object" },
        "unknownTypeRejected": { "type": "object" },
        "deduped": { "type": "object" }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "set"],
        "properties": {
          "name": { "type": "string" },
          "set": { "type": "boolean" },
          "mtime": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "gatesObservedAt": { "type": "string" },
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "binds",
          "enabled",
          "excluded",
          "delivered",
          "declined",
          "backoff"
        ],
        "properties": {
          "role": { "type": "string" },
          "binds": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "delivered": { "type": "integer", "minimum": 0 },
          "declined": { "type": "integer", "minimum": 0 },
          "backoff": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["streak", "nextEligible"],
                "properties": {
                  "streak": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state", "self"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "state": { "type": "string" },
          "self": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "enabled", "excluded", "mode", "failure"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["pull", "push"] },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "mode": { "enum": ["pull", "push"] },
          "lastTick": { "type": "string" },
          "failure": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["count", "nextEligible"],
                "properties": {
                  "count": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "unmatchedBindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "startedAt", "type", "outcome"],
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "startedAt": { "type": "string" },
          "type": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "activityDropped": { "type": "boolean" },
    "asOf": { "type": "string" },
    "lastTickAt": { "type": "string" },
    "snapshotAt": { "type": "string" },
    "tickIntervalMs": { "type": "integer", "minimum": 0 }
  }
}
