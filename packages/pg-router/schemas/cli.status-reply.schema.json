{
  "$id": "cli.status-reply",
  "title": "INTF-CLI status --json reply",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveries", "queues", "config"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handler", "event"],
        "properties": {
          "id": { "type": "string" },
          "handler": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "depth"],
        "properties": {
          "type": { "type": "string" },
          "depth": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "handlers"],
      "properties": {
        "sources": { "type": "integer", "minimum": 0 },
        "handlers": { "type": "integer", "minimum": 0 }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string" },
        "version": { "type": "string" },
        "pid": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string" },
        "configPath": { "type": "string" }
      }
    },
    "mode": { "type": "string" },
    "queueLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "compactions"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "compactions": { "type": "integer", "minimum": 0 },
        "limitBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "The hard size limit (max_log_bytes): at or above it new events are rejected with a log_full reason."
        },
        "softBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "The derived soft threshold (90% of limitBytes): above it, after a compaction attempt, polled emitters are halted."
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "description": "bytes as a percentage of limitBytes, rounded to one decimal; may exceed 100."
        },
        "state": {
          "enum": ["ok", "emitters_halted", "log_full", "log_unwritable"],
          "description": "The most severe log-limit state. emitters_halted is NOT a gate: it halts polled emitters only; listeners, drain, timer emitters and pushed events keep running. log_full and log_unwritable also reject new events with the matching reason prefix."
        },
        "emittersHalted": {
          "type": "boolean",
          "description": "True while polled command-source emitters are not being polled (past the soft threshold, or the log is unwritable)."
        },
        "rejected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logFull", "logUnwritable"],
          "description": "Event admissions refused since the core started, by reason (log_full / log_unwritable); push and pull together.",
          "properties": {
            "logFull": { "type": "integer", "minimum": 0 },
            "logUnwritable": { "type": "integer", "minimum": 0 }
          }
        },
        "detail": {
          "type": "string",
          "description": "The underlying write error while state is log_unwritable."
        },
        "lastCompaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "trigger",
            "bytesBefore",
            "bytesAfter",
            "recordsBefore",
            "recordsAfter",
            "durationMs"
          ],
          "description": "The most recent compaction this process completed; absent before the first one (startup compaction normally makes it present from the start).",
          "properties": {
            "at": {
              "type": "string",
              "description": "When it finished (RFC 3339)."
            },
            "trigger": {
              "enum": ["startup", "threshold", "limit", "manual"],
              "description": "What started it: startup, threshold (compact_threshold_bytes), limit (the soft log-size threshold) or manual (pg-router log compact)."
            },
            "bytesBefore": { "type": "integer", "minimum": 0 },
            "bytesAfter": { "type": "integer", "minimum": 0 },
            "recordsBefore": { "type": "integer", "minimum": 0 },
            "recordsAfter": { "type": "integer", "minimum": 0 },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["busy", "total"],
      "properties": {
        "busy": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "resolvedConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoRoot": { "type": "string" },
        "beadsPrefix": { "type": "string" },
        "pollIntervalMs": { "type": "integer", "minimum": 0 },
        "activeRoles": { "type": "integer", "minimum": 0 },
        "activeQueries": { "type": "integer", "minimum": 0 },
        "perParticipant": { "type": "object" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unconsumedExpired", "unknownTypeRejected", "deduped"],
      "properties": {
        "unconsumedExpired": { "type": "object" },
        "unknownTypeRejected": { "type": "object" },
        "deduped": { "type": "object" }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "setAt"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "setAt": { "type": "string" },
          "expiresAt": { "type": "string" },
          "ttlRemainingMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "binds",
          "enabled",
          "excluded",
          "delivered",
          "declined",
          "backoff",
          "description"
        ],
        "properties": {
          "role": { "type": "string" },
          "binds": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "delivered": { "type": "integer", "minimum": 0 },
          "declined": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "declinedByReason": { "type": "object" },
          "lastDeliveredAtMs": { "type": "integer", "minimum": 0 },
          "handlerFailures": { "type": "integer", "minimum": 0 },
          "selfReportState": { "type": "string" },
          "inFlight": { "type": "boolean" },
          "inFlightEventType": { "type": "string" },
          "backoff": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["streak", "nextEligible"],
                "properties": {
                  "streak": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state", "self"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "state": { "type": "string" },
          "self": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "enabled",
          "excluded",
          "mode",
          "failure",
          "description"
        ],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["pull", "push"] },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "mode": { "enum": ["pull", "push"] },
          "description": { "type": "string" },
          "expectedIntervalMs": { "type": "integer", "minimum": 0 },
          "lastTick": { "type": "string" },
          "inFlight": { "type": "boolean" },
          "failure": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["count", "nextEligible"],
                "properties": {
                  "count": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "unmatchedBindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "startedAt", "type", "outcome"],
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "startedAt": { "type": "string" },
          "type": { "type": "string" },
          "outcome": { "type": "string" },
          "participant": { "type": "string" }
        }
      }
    },
    "activityDropped": { "type": "boolean" },
    "asOf": { "type": "string" },
    "lastTickAt": { "type": "string" },
    "snapshotAt": { "type": "string" },
    "tickIntervalMs": { "type": "integer", "minimum": 0 }
  }
}
