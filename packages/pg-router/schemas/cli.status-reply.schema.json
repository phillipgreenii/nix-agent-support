{
  "$id": "cli.status-reply",
  "title": "INTF-CLI status --json reply",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveries", "queues", "config"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handler", "event"],
        "properties": {
          "id": { "type": "string" },
          "handler": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "depth"],
        "properties": {
          "type": { "type": "string" },
          "depth": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "handlers"],
      "properties": {
        "sources": { "type": "integer", "minimum": 0 },
        "handlers": { "type": "integer", "minimum": 0 }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string" },
        "version": { "type": "string" },
        "pid": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string" },
        "configPath": { "type": "string" }
      }
    },
    "mode": { "type": "string" },
    "queueLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "compactions"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "compactions": { "type": "integer", "minimum": 0 },
        "limitBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "The hard size limit (max_log_bytes): at or above it new events are rejected with a log_full reason."
        },
        "softBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "The derived soft threshold (90% of limitBytes): above it, after a compaction attempt, polled emitters are halted."
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "description": "bytes as a percentage of limitBytes, rounded to one decimal; may exceed 100."
        },
        "state": {
          "enum": ["ok", "emitters_halted", "log_full", "log_unwritable"],
          "description": "The most severe log-limit state. emitters_halted is NOT a gate: it halts polled emitters only; listeners, drain, timer emitters and pushed events keep running. log_full and log_unwritable also reject new events with the matching reason prefix."
        },
        "emittersHalted": {
          "type": "boolean",
          "description": "True while polled command-source emitters are not being polled (past the soft threshold, or the log is unwritable)."
        },
        "rejected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logFull", "logUnwritable"],
          "description": "Event admissions refused since the core started, by reason (log_full / log_unwritable); push and pull together.",
          "properties": {
            "logFull": { "type": "integer", "minimum": 0 },
            "logUnwritable": { "type": "integer", "minimum": 0 }
          }
        },
        "detail": {
          "type": "string",
          "description": "The underlying write error while state is log_unwritable."
        },
        "lastCompaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "trigger",
            "bytesBefore",
            "bytesAfter",
            "recordsBefore",
            "recordsAfter",
            "durationMs"
          ],
          "description": "The most recent compaction this process completed; absent before the first one (startup compaction normally makes it present from the start).",
          "properties": {
            "at": {
              "type": "string",
              "description": "When it finished (RFC 3339)."
            },
            "trigger": {
              "enum": ["startup", "threshold", "limit", "manual"],
              "description": "What started it: startup, threshold (compact_threshold_bytes), limit (the soft log-size threshold) or manual (pg-router log compact)."
            },
            "bytesBefore": { "type": "integer", "minimum": 0 },
            "bytesAfter": { "type": "integer", "minimum": 0 },
            "recordsBefore": { "type": "integer", "minimum": 0 },
            "recordsAfter": { "type": "integer", "minimum": 0 },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["busy", "total"],
      "properties": {
        "busy": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "resolvedConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoRoot": { "type": "string" },
        "beadsPrefix": { "type": "string" },
        "pollIntervalMs": { "type": "integer", "minimum": 0 },
        "activeRoles": { "type": "integer", "minimum": 0 },
        "activeQueries": { "type": "integer", "minimum": 0 },
        "perParticipant": { "type": "object" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unconsumedExpired", "unknownTypeRejected", "deduped"],
      "properties": {
        "unconsumedExpired": { "type": "object" },
        "unknownTypeRejected": { "type": "object" },
        "deduped": { "type": "object" }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource"],
        "properties": {
          "resource": { "type": "string" },
          "level": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["sensor", "operator", "grace_fallback"]
          },
          "owner": { "type": "string" },
          "observed_at": { "type": "string" },
          "received_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "age_s": { "type": "integer", "minimum": 0 },
          "stale": { "type": "boolean" },
          "no_sensor": { "type": "boolean" },
          "since": { "type": "string" },
          "reading": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string" }
            }
          },
          "override": {
            "type": "object",
            "additionalProperties": false,
            "required": ["until_cleared"],
            "properties": {
              "until_cleared": { "type": "boolean" },
              "expires_at": { "type": "string" }
            }
          }
        }
      }
    },
    "pausedRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "failing"],
        "properties": {
          "role": { "type": "string" },
          "failing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clause", "resource", "kind"],
              "properties": {
                "clause": { "type": "string" },
                "resource": { "type": "string" },
                "level": { "type": "string" },
                "kind": {
                  "type": "string",
                  "enum": ["level", "unknown", "stale"]
                },
                "source": { "type": "string" },
                "owner": { "type": "string" },
                "since": { "type": "string" },
                "allowed": { "type": "array", "items": { "type": "string" } },
                "reading": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "unit"],
                  "properties": {
                    "value": { "type": "number" },
                    "unit": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "binds",
          "enabled",
          "excluded",
          "delivered",
          "declined",
          "backoff",
          "description",
          "progress",
          "busy"
        ],
        "properties": {
          "role": { "type": "string" },
          "binds": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "delivered": { "type": "integer", "minimum": 0 },
          "declined": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "declinedByReason": { "type": "object" },
          "lastDeliveredAtMs": { "type": "integer", "minimum": 0 },
          "handlerFailures": { "type": "integer", "minimum": 0 },
          "selfReportState": { "type": "string" },
          "unavailableReason": { "type": "string" },
          "inFlight": { "type": "boolean" },
          "inFlightEventType": { "type": "string" },
          "busy": { "type": "boolean" },
          "progress": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ageSeconds", "unsuccessful", "busy"],
                "properties": {
                  "ageSeconds": { "type": "number", "minimum": 0 },
                  "unsuccessful": { "type": "integer", "minimum": 0 },
                  "busy": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          },
          "backoff": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["streak", "nextEligible"],
                "properties": {
                  "streak": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state", "self"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "state": { "type": "string" },
          "self": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "enabled",
          "excluded",
          "mode",
          "failure",
          "description",
          "busy"
        ],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["pull", "push"] },
          "enabled": { "type": "boolean" },
          "excluded": { "type": "boolean" },
          "mode": { "enum": ["pull", "push"] },
          "description": { "type": "string" },
          "expectedIntervalMs": { "type": "integer", "minimum": 0 },
          "lastTick": { "type": "string" },
          "inFlight": { "type": "boolean" },
          "busy": { "type": "boolean" },
          "calendar": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schedule", "onMissed", "next"],
            "description": "Present only for a calendar-triggered source: the resolved schedule, the policy, the next fire and the last handled slot from the state file.",
            "properties": {
              "schedule": {
                "type": "string",
                "description": "For example: calendar 03:30 sun America/Los_Angeles."
              },
              "onMissed": { "enum": ["run-now", "next-slot"] },
              "next": {
                "type": "string",
                "description": "The next slot, RFC 3339 in the trigger zone, minute precision."
              },
              "last": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slot", "outcome"],
                "description": "Absent until a slot has been handled.",
                "properties": {
                  "slot": {
                    "type": "string",
                    "description": "The last handled slot, RFC 3339 in the trigger zone, minute precision."
                  },
                  "outcome": { "enum": ["fired", "catch_up", "skipped"] },
                  "reason": {
                    "type": "string",
                    "description": "Why, as stored: router not running, host asleep, enqueue failed, first start, or late by <d>."
                  }
                }
              }
            }
          },
          "failure": {
            "oneOf": [
              { "enum": [null] },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["count", "nextEligible"],
                "properties": {
                  "count": { "type": "integer", "minimum": 0 },
                  "nextEligible": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "busy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "sources"],
      "properties": {
        "roles": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unmatchedBindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "startedAt", "type", "outcome"],
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "startedAt": { "type": "string" },
          "type": { "type": "string" },
          "outcome": { "type": "string" },
          "participant": { "type": "string" }
        }
      }
    },
    "activityDropped": { "type": "boolean" },
    "asOf": { "type": "string" },
    "lastTickAt": { "type": "string" },
    "snapshotAt": { "type": "string" },
    "tickIntervalMs": { "type": "integer", "minimum": 0 }
  }
}
