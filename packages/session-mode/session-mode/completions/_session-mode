#compdef session-mode

_session_mode() {
  local -a commands
  commands=(
    'start:Create or refresh this session'"'"'s mode record'
    'set-status:Update the state of this session'"'"'s mode record'
    'show:Print the raw record for this session'
    'hook:Internal — invoked by Claude Code hooks'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help message]' \
    '(-v --version)'{-v,--version}'[Show version information]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
  command)
    _describe -t commands 'session-mode subcommands' commands
    ;;
  args)
    case $words[1] in
    start)
      _arguments \
        '--detail[Short gist of what this run is scoped to]:text:' \
        '--force[Always (re)create the record, discarding any conflict]' \
        '1:kind:'
      ;;
    set-status)
      _values 'state' running stopping finished
      ;;
    hook)
      _values 'hook event' session-end
      ;;
    esac
    ;;
  esac
}

_session_mode "$@"
