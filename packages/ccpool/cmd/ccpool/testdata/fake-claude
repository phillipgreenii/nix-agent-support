#!/usr/bin/env bash
# fake-claude — test stub. Fires SessionStart, then on each input line writes an
# assistant reply to the transcript and fires Stop (one "turn" per line).
set -uo pipefail

uuid=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) uuid="$2"; shift 2 ;;
    --name|--model|--plugin-dir|--resume) shift 2 ;;
    *) shift ;;
  esac
done

cc="${CCPOOL_BIN:-ccpool}"
transcript="${FAKE_CLAUDE_TRANSCRIPT:-/tmp/fake-claude-$uuid.jsonl}"
: > "$transcript"

payload() { printf '{"session_id":"%s","transcript_path":"%s","cwd":"%s","hook_event_name":"%s"}' "$uuid" "$transcript" "$PWD" "$1"; }

payload SessionStart | "$cc" hook start || true

# One turn per input line. Ignore the line content (bracketed-paste markers).
while IFS= read -r _line; do
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"OK-DONE"}]}}\n' >> "$transcript"
  payload Stop | "$cc" hook stop || true
done
