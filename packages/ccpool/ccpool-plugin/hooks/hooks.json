{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "ccpool hook start" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "ccpool hook stop" }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "ccpool hook fail" }] }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "ccpool hook end", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [{ "type": "command", "command": "ccpool hook notify" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "ccpool hook ask" }]
      }
    ]
  }
}
