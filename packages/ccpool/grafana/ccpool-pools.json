{
  "uid": "ccpool-pools",
  "title": "ccpool pools",
  "tags": ["ccpool"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "ccpool sessions grouped by pool (the basename of the pool directory). The pool variable lists the pools that report capacity, and All expands to those pools. A series with no pgrouter_role label is shown as unlabelled.",
  "templating": {
    "list": [
      {
        "name": "pool",
        "label": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ccpool_pool_capacity, pool)",
        "definition": "label_values(ccpool_pool_capacity, pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "value": "$__all",
          "text": "All"
        }
      },
      {
        "name": "role",
        "label": "role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ccpool_sessions_preserved_for_human, pgrouter_role)",
        "definition": "label_values(ccpool_sessions_preserved_for_human, pgrouter_role)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "value": "$__all",
          "text": "All"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Run duration (p50 / p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Duration of one session run (launch or resume), by pool. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, pool) (rate(ccpool_session_duration_seconds_bucket{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pool}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(ccpool_session_duration_seconds_bucket{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "unit": "s",
          "noValue": "no runs in window"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "How runs ended",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Runs ended over the selected time range, by pool and result (idle_ttl, cap_eviction, operator, handler, exited). Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool, result) (increase(ccpool_sessions_closed_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__range]))",
          "legendFormat": "{{pool}} / {{result}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 4,
      "title": "Retries and failures",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Retry attempts by pool and class, and genuine retry-policy exhaustion by pool. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool, class) (increase(ccpool_retries_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "retries {{pool}} / {{class}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (increase(ccpool_retry_exhausted_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "exhausted {{pool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "no retries yet (or exporter down)",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Launch outcomes and cancels",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Launch outcomes by pool, outcome and route, and cancel outcomes by pool. Router-wide failures live on the pg-router dashboard. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool, outcome, route) (increase(ccpool_launch_outcome_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "launch {{pool}} / {{outcome}} / {{route}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool, outcome) (increase(ccpool_cancel_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval]))",
          "legendFormat": "cancel {{pool}} / {{outcome}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "no launches in window",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Tokens and capacity",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 8,
      "title": "Tokens in live sessions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Output tokens used so far by each LIVE Claude session, grouped by pool. Source: pa-monitor session_tokens, which is CUMULATIVE over the session (the sum of output_tokens across the session's assistant messages in the transcript; it is not the current context size, which pa-monitor reports separately as context_tokens). Only live sessions appear: a session's series vanishes when it ends, so this is not a per-pool lifetime total; see the finished-session panels for ended sessions. Like the finished-session counter, it counts each distinct assistant message once (a multi-block turn is written as one transcript line per block, all repeating the same usage). Sessions not managed by ccpool are excluded. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (pool, pgrouter_role) (max by (session_id) (pa_monitor_session_tokens)\n  * on (session_id) group_left (pool, pgrouter_role)\n    label_replace(\n      max by (claude_session_id, pool, pgrouter_role) (ccpool_session_info{pool=~\"$pool\", pgrouter_role=~\"$role\"}),\n      \"session_id\", \"$1\", \"claude_session_id\", \"(.*)\"\n    )), \"pgrouter_role\", \"unlabelled\", \"pgrouter_role\", \"^$\")",
          "legendFormat": "{{pool}} / {{pgrouter_role}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "noValue": "none (or exporter down)",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sessions in use (dim=live) against the pool maximum (dim=max_sessions), by pool. Pool values are directory basenames, the same as the pool variable. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pool) (ccpool_pool_capacity{dim=\"live\", pool=~\"$pool\"})",
          "legendFormat": "in use {{pool}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pool) (ccpool_pool_capacity{dim=\"max_sessions\", pool=~\"$pool\"})",
          "legendFormat": "capacity {{pool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Tokens in finished sessions",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Output tokens produced by sessions whose run has ENDED, over the selected time range, by pool and role. Source: ccpool_session_output_tokens_total, incremented once per ended run from the session transcript (counted once per distinct assistant message, so a resumed session contributes only the tokens produced since its previous run ended). Use together with 'Tokens in live sessions' for sessions still running; the two are not summed because a resumed live session's cumulative gauge already includes tokens counted when its earlier run ended. A session whose transcript is gone before the run is emitted (a pruned phantom) cannot be attributed. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (pool, pgrouter_role) (increase(ccpool_session_output_tokens_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__range])), \"pgrouter_role\", \"unlabelled\", \"pgrouter_role\", \"^$\")",
          "legendFormat": "{{pool}} / {{pgrouter_role}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 11,
      "title": "Tokens in finished sessions over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Output tokens produced by sessions whose run ended in each interval, by pool and role (see 'Tokens in finished sessions' for the counting rules). A run is attributed at the reaper's next sweep after it ends, so bars lag the actual end by up to 300 s. Manual operator CLI invocations without an OTLP endpoint in their environment are not counted (out of scope). A run ended by the hook is counted at the reaper's next sweep (up to 300 s late). Counter panels require delta temporality end to end.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (pool, pgrouter_role) (increase(ccpool_session_output_tokens_total{pool=~\"$pool\",pgrouter_role=~\"$role\"}[$__rate_interval])), \"pgrouter_role\", \"unlabelled\", \"pgrouter_role\", \"^$\")",
          "legendFormat": "{{pool}} / {{pgrouter_role}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "no tokens in window",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Session health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sessions by state",
      "description": "Sessions by state and liveness (live=true means the owning process is alive). Source: ccpool_session_states, deduplicated per pool and role with max by before summing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{state}} / live={{live}}",
          "expr": "sum by (state, live) (max by (state, live, pool, pgrouter_role) (ccpool_session_states))"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Preserved for human",
      "description": "Sessions preserved for a human to look at, by pool. Source: ccpool_sessions_preserved_for_human, deduplicated per pool and role with max by before summing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "{{pool}}",
          "expr": "sum by (pool) (max by (pool, pgrouter_role) (ccpool_sessions_preserved_for_human{pool=~\"$pool\",pgrouter_role=~\"$role\"}))"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "needs_input (live)",
      "description": "Live sessions waiting for input. Zero is shown only while the exporter is reporting capacity; a dead exporter shows No data, not a green 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "legendFormat": "",
          "expr": "sum(max by (state, live, pool, pgrouter_role) (ccpool_session_states{state=\"needs_input\",live=\"true\"})) or (vector(0) and on() (max(ccpool_pool_capacity) >= 0))"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "dead-but-working",
      "description": "Sessions recorded as working whose process is dead. Zero is shown only while the exporter is reporting capacity; a dead exporter shows No data, not a green 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 44,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "legendFormat": "",
          "expr": "sum(max by (state, live, pool, pgrouter_role) (ccpool_session_states{state=\"working\",live=\"false\"})) or (vector(0) and on() (max(ccpool_pool_capacity) >= 0))"
        }
      ]
    }
  ]
}
