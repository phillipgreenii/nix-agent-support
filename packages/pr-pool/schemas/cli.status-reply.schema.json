{
  "$id": "cli.status-reply",
  "title": "INTF-CLI status --json reply",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveries", "queues", "config"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handler", "event"],
        "properties": {
          "id": { "type": "string" },
          "handler": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "depth"],
        "properties": {
          "type": { "type": "string" },
          "depth": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "handlers"],
      "properties": {
        "sources": { "type": "integer", "minimum": 0 },
        "handlers": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
