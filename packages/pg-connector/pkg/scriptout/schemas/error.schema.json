{
  "$id": "error",
  "title": "scriptout wire error object",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "enum": [
        "not_found",
        "unauthenticated",
        "unavailable",
        "unknown_op",
        "version_mismatch",
        "invalid_argument"
      ]
    },
    "message": { "type": "string" }
  }
}
