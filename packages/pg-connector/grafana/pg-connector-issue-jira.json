            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (served_from) (rate(pg_connector_issue_jira_request_duration_count{served_from!=\"none\"}[$__rate_interval])) / ignoring(served_from) group_left sum(rate(pg_connector_issue_jira_request_duration_count{served_from!=\"none\"}[$__rate_interval]))",
