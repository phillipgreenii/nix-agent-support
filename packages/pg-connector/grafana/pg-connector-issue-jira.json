    {
      "id": 9,
      "type": "timeseries",
      "title": "Served-from ratio",
      "description": "The share of answers by where they were served from, over the dashboard's rate interval: each served_from value's rate of the request duration count divided by the total rate, so it is a windowed ratio and not the lifetime count. Requests with served_from none (answers that were not served from data) are excluded from both sides.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (served_from) (rate(pg_connector_issue_jira_request_duration_count{served_from!=\"none\"}[$__rate_interval])) / ignoring(served_from) group_left sum(rate(pg_connector_issue_jira_request_duration_count{served_from!=\"none\"}[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{served_from}}"
        }
      ],
