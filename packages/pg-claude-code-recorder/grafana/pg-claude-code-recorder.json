{
  "uid": "pg-claude-code-recorder",
  "title": "pg-claude-code-recorder",
  "schemaVersion": 39,
  "tags": ["pg-claude-code-recorder"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Copy and parse lag",
      "description": "Age of the oldest byte the recorder has seen but not yet copied (copy lag) and not yet parsed (parse lag), in seconds. The copy-lag alert fires above 120 s for 10 minutes; parse-stuck fires when parse lag bytes stay above 0 with no progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_copy_lag_seconds)",
          "range": true,
          "legendFormat": "copy lag"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_parse_lag_seconds)",
          "range": true,
          "legendFormat": "parse lag"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Conversations by stage",
      "description": "Conversations per stage: live, quiet, held, settled, removal_pending, removed, as of the last settle tick, up to a minute old.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (stage) (pg_claude_code_recorder_conversations_by_stage)",
          "range": true,
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Held age",
      "description": "Age of the oldest held Conversation (the held-old alert fires above 3 days) and the number held by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_oldest_held_age_seconds)",
          "range": true,
          "legendFormat": "oldest held age"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (reason) (pg_claude_code_recorder_held_conversations)",
          "range": true,
          "legendFormat": "held: {{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dropped bytes by reason",
      "description": "Bytes the recorder saw but could not keep, per reason, over the rate interval. Any increase fires the data-loss alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(pg_claude_code_recorder_dropped_bytes_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Removal backlog",
      "description": "Settled Conversations eligible for removal that have not been removed (the removal-backlog alert fires above 24 hours of remove.maxPerHour), their bytes and the age of the oldest quarantined file.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_removal_backlog_conversations)",
          "range": true,
          "legendFormat": "backlog, Conversations"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_removal_backlog_bytes)",
          "range": true,
          "legendFormat": "backlog, bytes"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_quarantine_oldest_age_seconds)",
          "range": true,
          "legendFormat": "oldest quarantine age, seconds"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Processes without an inbox",
      "description": "Live Claude Processes with no control inbox, and the control inbox states: present, gone (the Process had one and lost it; the control-inbox-gone alert) and never_loaded (started without the mod).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_processes_without_control_inbox)",
          "range": true,
          "legendFormat": "without an inbox"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (state) (pg_claude_code_recorder_control_inbox_state)",
          "range": true,
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate by client",
      "description": "Requests per second to the recorder by whitelisted client name (anything else is other).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client) (rate(pg_claude_code_recorder_requests_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{client}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "settle tick duration",
      "description": "Duration of one settle tick in seconds: p50 and p99 over a window of at least 5 minutes (a tick runs once a minute, so a shorter window holds about one sample) and the last tick. The line at 60 s is the one-minute scan tick interval, which also bounds a settle.reconcile scan while that scan exists. In event mode a wake should finish well inside settle.min_wake (5 s by default). The settle-tick-slow alert covers this panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pg_claude_code_recorder_settle_tick_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pg_claude_code_recorder_settle_tick_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_settle_tick_last_duration_seconds)",
          "range": true,
          "legendFormat": "last"
        }
      ],
      "interval": "5m"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "settle tick work",
      "description": "Sessions processed per wake (settle_tick_examined_total, per second) and stage transitions made, per second. In scan mode a wake is one whole-store tick; in event mode it is one batch of dirty or due sessions. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_claude_code_recorder_settle_tick_examined_total[$__rate_interval])",
          "range": true,
          "legendFormat": "examined"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_claude_code_recorder_settle_tick_transitions_total[$__rate_interval])",
          "range": true,
          "legendFormat": "transitions"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "loop runs by outcome",
      "description": "Runs of each periodic loop (settle_tick, refresh_gauges, wal_checkpoint) per second by outcome, ok or error. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (loop, outcome) (rate(pg_claude_code_recorder_loop_runs_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{loop}} {{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "recorder cpu cores",
      "description": "CPU the recorder process uses, in cores (1 is one full core), and the share of it spent in garbage-collection pauses. The cpu-high alert fires above 1 core for 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_claude_code_recorder_process_cpu_seconds_total[$__rate_interval])",
          "range": true,
          "legendFormat": "cpu cores"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_claude_code_recorder_go_gc_pause_seconds_total[$__rate_interval])",
          "range": true,
          "legendFormat": "gc pause"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "go heap",
      "description": "Live heap allocated by the Go runtime, in bytes. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_go_memstats_heap_alloc_bytes)",
          "range": true,
          "legendFormat": "heap alloc"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "go goroutines",
      "description": "Number of goroutines in the recorder process. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_go_goroutines)",
          "range": true,
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "refresh gauges duration",
      "description": "p99 duration of the gauge refresh loop in seconds. Expected value: a few milliseconds (not seconds) now that the gauges are maintained from commits. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pg_claude_code_recorder_refresh_gauges_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "wal size",
      "description": "Size of the SQLite write-ahead log file in bytes. The periodic TRUNCATE checkpoint runs above wal.truncate_above (512 MiB); the wal-large alert fires above 1 GiB for 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_wal_bytes)",
          "range": true,
          "legendFormat": "wal"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "wal checkpoint frames",
      "description": "Frames in the WAL and frames already checkpointed, as of the last passive checkpoint (pages, not bytes; both count up until the WAL restarts). A gap that stays open means a reader pins the WAL. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_wal_frames)",
          "range": true,
          "legendFormat": "wal frames"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_wal_checkpointed_frames)",
          "range": true,
          "legendFormat": "checkpointed"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "wal checkpoint duration",
      "description": "p99 duration of the passive WAL checkpoint in seconds. no alert covers this panel yet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pg_claude_code_recorder_wal_checkpoint_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Field type mismatches",
      "description": "Catalogued field values that did not convert losslessly to their declared storage type, per source, type and field, over the rate interval. Any increase in an hour fires the field-type-mismatch alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source, type, field) (increase(pg_claude_code_recorder_field_type_mismatch_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "{{source}} {{type}} {{field}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Unknown key growth",
      "description": "New JSON keys the parser does not know, per hour (a stepped increase means Claude Code added a field), and the rate over the rate interval. More than 100 in an hour fires the unknown-key-burst alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pg_claude_code_recorder_unknown_keys_total[1h]))",
          "range": true,
          "legendFormat": "new keys in the last hour"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pg_claude_code_recorder_unknown_keys_total[$__rate_interval]))",
          "range": true,
          "legendFormat": "new keys per interval"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "loop duration p99 by loop",
      "description": "p99 duration of one pass of each periodic loop (all 11: settle_tick, refresh_gauges, wal_checkpoint, watcher_sweep, copier_ingest, parser_drain, tracker_tick, tracker_poll, status_refresh, doctor, removal_pass), in seconds, over a window of at least 5 minutes. removal_pass is nested inside settle_tick, not additive. The loop-stalled alert covers loops that stop or hang, not a slow pass; no alert covers a slow pass yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, loop) (rate(pg_claude_code_recorder_loop_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "{{loop}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "loop runs by loop and outcome",
      "description": "Passes per second of each periodic loop by outcome, ok or error (copier_ingest is per event and is counted by ingest results instead). The loop-stalled alert covers a loop whose passes stop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
