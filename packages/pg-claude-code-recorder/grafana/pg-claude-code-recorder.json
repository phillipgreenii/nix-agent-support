          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_claude_code_recorder_doctor_cursor_age_seconds)",
          "range": true,
          "legendFormat": "cursor age"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
